# ── SpecHub 部署环境变量样例 ──────────────────────────────────────────
# 用法：cp .env.example .env 后按需修改。.env 已被 .gitignore 忽略（不提交）。
# 未设置项由 docker-compose.yml 内 `:-默认值` 兜底；可用值前缀约定：
#   SPECHUB_*  ：backend 通用配置（端口/目录/URL，E1 配置绑定认同一套前缀）
#   GITEA_*    ：内置 Gitea 专用

# 对外访问 URL（用户浏览器地址；Gitea 与 backend 共用给用户的入口基址）
SPECHUB_EXTERNAL_URL=http://localhost:3000

# 内置 Gitea 宿主机端口（HTTP / SSH）
SPECHUB_GITEA_HTTP_PORT=3000
SPECHUB_GITEA_SSH_PORT=2222

# backend HTTP 宿主机端口
SPECHUB_PORT=8080

# 内置 Gitea 是否关闭用户自助注册（admin 由后端初始化，见开发计划 E8）
GITEA_DISABLE_REGISTRATION=true

# ── 数据卷挂载点（容器内路径）在 docker-compose.yml 中定义，默认即可，勿在此重复 ──