# ── SpecHub 部署环境变量样例 ──────────────────────────────────────────
# 用法：cp .env.example .env 后按需修改。.env 已被 .gitignore 忽略（不提交）。
# 未设置项由 docker-compose.yml 内 `:-默认值` 兜底；可用值前缀约定：
#   SPECHUB_*  ：backend 通用配置（端口/目录/URL，E1 配置绑定认同一套前缀）
#   GITEA_*    ：内置 Gitea 专用

# 对外访问 URL（用户浏览器地址；Gitea 与 backend 共用给用户的入口基址）
SPECHUB_EXTERNAL_URL=http://localhost:3000

# 内置 Gitea 宿主机端口（HTTP / SSH）
SPECHUB_GITEA_HTTP_PORT=3000
SPECHUB_GITEA_SSH_PORT=2222

# backend HTTP 宿主机端口
SPECHUB_PORT=8080

# 管理库密码（compose 内置 PostgreSQL；生产部署必须覆盖）
SPECHUB_DB_PASSWORD=spechub
# 管理库宿主机端口（可选，默认 5432）
SPECHUB_DB_PORT=5432

# Spring profile：dev（默认，与 prod 使用同一套真实登录）| prod（必须同时提供 SPECHUB_ADMIN_TOKEN）
SPRING_PROFILES_ACTIVE=dev
# 所有 profile 必填：首次 bootstrap / break-glass admin 令牌（缺失/空串 → 启动失败）
# 开发者用 admin + 该令牌登录换取 Spring Session，再设置密码 / 绑定 OIDC。
SPECHUB_ADMIN_TOKEN=change-me-dev-admin-token

# 阶段 C：Spring Session Data Redis（compose 内置 redis 服务；宿主机端口可改）
SPECHUB_REDIS_PORT=6379
# backend 连接串：compose 网络内默认 redis://redis:6379；后端跑在宿主机时用 redis://localhost:6379
# SPECHUB_REDIS_URL=redis://redis:6379

# 会话 Cookie 是否带 Secure（prod HTTPS 必须 true；本机 HTTP dev 用 false）
# 会话：HttpOnly + SameSite=Lax；空闲 24h / 绝对 7 天；Redis 不可用时认证 fail-closed
SPECHUB_SESSION_COOKIE_SECURE=false

# 审计事件保留天数（每日清理，默认 365）
SPECHUB_AUDIT_RETENTION_DAYS=365

# ── C6：OIDC（可选；enabled=false 时只保留密码 / 令牌登录）──
SPECHUB_OIDC_ENABLED=false
# SPECHUB_OIDC_ISSUER_URI=https://idp.example.com/realms/spechub
# SPECHUB_OIDC_CLIENT_ID=spechub
# SPECHUB_OIDC_CLIENT_SECRET=
# 回调必须与浏览器访问地址同源（默认 ${SPECHUB_EXTERNAL_URL}/login/oauth2/code/spechub）；
# Vite dev 下将 external-url / redirect-uri 指向前端地址（如 http://localhost:5173）
# SPECHUB_OIDC_REDIRECT_URI=${SPECHUB_EXTERNAL_URL}/login/oauth2/code/spechub
# SPECHUB_OIDC_AUTO_PROVISION=false
# SPECHUB_OIDC_REQUIRE_VERIFIED_EMAIL=true

# 内置 Gitea 是否关闭用户自助注册（admin 由后端初始化，见开发计划 E8）
GITEA_DISABLE_REGISTRATION=true

# ── 数据卷挂载点（容器内路径）在 docker-compose.yml 中定义，默认即可，勿在此重复 ──